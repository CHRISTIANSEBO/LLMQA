# LLMQA configuration. Copy to `.env` (gitignored) and fill in what you need.
# Everything here is optional: with no keys, LLMQA runs on the free,
# deterministic `mock` provider. cli.py and server.py auto-load `.env`.

# --- Real model providers (self-hosted only) --------------------------------
# Set a key to enable that provider by name (--provider anthropic|openai|xai).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...

# Determinism knobs for live providers (defaults shown).
# LLMQA_TEMPERATURE=0.0
# LLMQA_SEED=42
# Use real embedding cosine similarity instead of Jaccard (needs an OpenAI key).
# LLMQA_SIMILARITY=embeddings

# --- Persistence ------------------------------------------------------------
# Persist the response cache to a SQLite file (survives restarts, shared across
# workers). Without this the cache is per-process/in-memory.
# LLMQA_CACHE=.llmqa_cache.db
# Where the web app stores run history.
# LLMQA_DB=llmqa_runs.db

# --- Web dashboard ----------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# Auto-reload on code change (dev only): 1/true/yes/on.
# LLMQA_RELOAD=0

# --- Hardening a public deploy ----------------------------------------------
# Real (paid) providers are BLOCKED by default even if keys are set; opt in:
# LLMQA_ALLOW_REAL_PROVIDERS=1
# Require `Authorization: Bearer <token>` on mutating endpoints:
# LLMQA_API_TOKEN=change-me
# Per-IP sliding-window rate limit on run endpoints (0 disables).
# LLMQA_RATE_LIMIT=30
# LLMQA_RATE_WINDOW_S=60
# CORS is closed by default; set a comma-separated allowlist for a split deploy.
# ALLOWED_ORIGINS=https://app.example.com
